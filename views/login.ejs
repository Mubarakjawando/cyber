<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Login — TDPS</title>
  <link rel="stylesheet" href="/css/styles.css?v=3">
  <% if (showCaptcha) { %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <% } %>
</head>
<body class="auth-split">
  <div class="auth-photo">
    <div class="top-mark">
      Moshood Abiola Polytechnic
      <span class="sub">Abeokuta, Ogun State</span>
    </div>
    <div class="tagline">Secure access to your student and staff portal.</div>
  </div>

  <div class="auth-form-pane">
    <div class="auth-shell">
      <div class="wordmark" style="display:flex; align-items:center; gap:8px;">
        <img src="/images/mapoly-crest.png" alt="MAPOLY crest" style="height:30px; width:auto; padding:2px; background:#fff; border-radius:5px; box-shadow:0 0 0 1px var(--paper-line);">
        MAPOLY Portal Security
      </div>
      <div class="card">
        <h1>Sign in</h1>
        <p class="subtitle">Access your student or staff account.</p>

        <% if (error) { %>
          <div class="banner <%= showCaptcha ? 'banner-warn' : 'banner-danger' %>"><%= error %></div>
        <% } %>

        <form method="POST" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" required autofocus>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
          </div>

          <% if (showCaptcha) { %>
            <div class="field">
              <label>Verify you're not a bot</label>
              <div class="captcha-wrap">
                <div class="g-recaptcha" data-sitekey="<%= siteKey %>"></div>
              </div>
            </div>
          <% } %>

          <button type="submit" class="btn-primary">Sign in</button>
        </form>
      </div>
      <div class="auth-footer">Need an account? <a href="/register">Register</a></div>
    </div>
  </div>
</body>
</html>
