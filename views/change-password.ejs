<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Change password — TDPS</title>
  <link rel="stylesheet" href="/css/styles.css?v=3">
</head>
<body class="auth">
  <div class="auth-shell">
    <div class="wordmark" style="display:flex; align-items:center; gap:8px;">
        <img src="/images/mapoly-crest.png" alt="MAPOLY crest" style="height:30px; width:auto; padding:2px; background:#fff; border-radius:5px; box-shadow:0 0 0 1px var(--paper-line);">
        MAPOLY Portal Security
      </div>
    <div class="card">
      <h1>Change password</h1>
      <p class="subtitle">Signed in as <span class="pill pill-ok"><%= role %></span> <%= username %></p>

      <% if (error) { %><div class="banner banner-danger"><%= error %></div><% } %>
      <% if (success) { %><div class="banner" style="background: var(--ok-soft); color: var(--ok);"><%= success %></div><% } %>

      <form method="POST" action="/account/change-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label for="current_password">Current password</label>
          <input type="password" id="current_password" name="current_password" required>
        </div>

        <div class="field">
          <label for="new_password">New password</label>
          <input type="password" id="new_password" name="new_password" required>
        </div>

        <div class="field">
          <label for="confirm_password">Confirm new password</label>
          <input type="password" id="confirm_password" name="confirm_password" required>
        </div>

        <button type="submit" class="btn-primary">Update password</button>
      </form>
    </div>
    <div class="auth-footer"><a href="/dashboard">Back to dashboard</a></div>
  </div>
</body>
</html>
