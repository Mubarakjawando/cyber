<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Contact support — TDPS</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="auth">
  <div class="auth-shell" style="max-width: 480px;">
    <div class="wordmark" style="display:flex; align-items:center; gap:8px;">
      <img src="/images/mapoly-crest.png" alt="MAPOLY crest" style="height:30px; width:auto; padding:2px; background:#fff; border-radius:5px; box-shadow:0 0 0 1px var(--paper-line);">
      MAPOLY Portal Security
    </div>
    <div class="card" style="max-width: 480px;">
      <h1>Contact support</h1>
      <p class="subtitle">Report an issue or ask a question. An administrator will reply here.</p>

      <% if (error) { %><div class="banner banner-danger"><%= error %></div><% } %>
      <% if (success) { %><div class="banner" style="background: var(--ok-soft); color: var(--ok);"><%= success %></div><% } %>

      <form method="POST" action="/support">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required>
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required style="width:100%; padding:10px 12px; border:1px solid var(--paper-line); border-radius:6px; font-family: var(--sans); font-size:14.5px; resize:vertical;"></textarea>
        </div>

        <button type="submit" class="btn-primary">Send message</button>
      </form>
    </div>

    <% if (messages.length > 0) { %>
      <div style="margin-top: 28px;">
        <p class="subtitle" style="margin-bottom:10px;">Your previous messages</p>
        <% messages.forEach(m => { %>
          <div class="card" style="max-width:480px; margin-bottom:14px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <strong style="font-size:14.5px;"><%= m.subject %></strong>
              <span class="pill <%= m.status === 'open' ? 'pill-warn' : 'pill-ok' %>"><%= m.status %></span>
            </div>
            <p style="font-size:13.5px; color: var(--muted-on-paper); margin:0 0 10px;"><%= m.message %></p>
            <p style="font-size:12px; color: var(--muted-on-paper); margin:0;"><%= m.created_at %></p>
            <% if (m.admin_reply) { %>
              <div style="margin-top:12px; padding:10px 12px; background: var(--paper); border-radius:6px; border-left:3px solid var(--brand);">
                <p style="font-size:12px; font-weight:600; color: var(--brand); margin:0 0 4px;">Administrator reply</p>
                <p style="font-size:13.5px; margin:0;"><%= m.admin_reply %></p>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="auth-footer"><a href="/dashboard">Back to dashboard</a></div>
  </div>
</body>
</html>
