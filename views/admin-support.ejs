<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content="15">
  <title>Support inbox — TDPS</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="console">
  <div class="console-topbar">
    <div class="system-name" style="display:flex; align-items:center; gap:10px;">
      <img src="/images/mapoly-crest.png" alt="MAPOLY crest" style="height:28px; width:auto; padding:2px; background:#fff; border-radius:5px;">
      TDPS Console <span>support inbox</span>
    </div>
    <nav><a href="/admin">Back to console</a></nav>
  </div>

  <div class="console-body" style="max-width: 760px;">
    <div class="panel">
      <table>
        <thead>
          <tr><th>Subject</th><th>From</th><th>Status</th><th class="mono">Last activity</th></tr>
        </thead>
        <tbody>
          <% threads.forEach(t => { %>
            <tr style="cursor:pointer;" onclick="window.location='/admin/support/<%= t.thread_id %>'">
              <td><%= t.subject %></td>
              <td>
                <%= t.username %><% if (t.matric_or_staff_no) { %> (<%= t.matric_or_staff_no %>)<% } %>
                <% if (t.is_guest) { %><span class="pill pill-danger" style="margin-left:6px;">guest</span><% } %>
              </td>
              <td><span class="pill <%= t.status === 'open' ? 'pill-warn' : 'pill-ok' %>"><%= t.status %></span></td>
              <td class="mono"><%= t.updated_at %></td>
            </tr>
          <% }) %>
          <% if (threads.length === 0) { %>
            <tr class="empty-row"><td colspan="4">No support conversations yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
