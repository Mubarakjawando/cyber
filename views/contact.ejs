<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <% if (mode === 'chat') { %><meta http-equiv="refresh" content="10"><% } %>
  <title>Contact support — TDPS</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="auth">
  <div class="auth-shell" style="max-width: 480px;">
    <div class="wordmark" style="display:flex; align-items:center; gap:8px;">
      <img src="/images/mapoly-crest.png" alt="MAPOLY crest" style="height:30px; width:auto; padding:2px; background:#fff; border-radius:5px; box-shadow:0 0 0 1px var(--paper-line);">
      MAPOLY Portal Security
    </div>

    <% if (mode === 'form') { %>
      <div class="card" style="max-width:480px;">
        <h1>Contact support</h1>
        <p class="subtitle">Can't log in, or need help with something else? An administrator will verify your details and reply here — this page will keep showing your conversation, even without an account.</p>

        <% if (error) { %><div class="banner banner-danger"><%= error %></div><% } %>

        <form method="POST" action="/contact">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="full_name">Full name / username</label>
            <input type="text" id="full_name" name="full_name" required>
          </div>
          <div class="field">
            <label for="matric_or_staff_no">Matric / staff number</label>
            <input type="text" id="matric_or_staff_no" name="matric_or_staff_no" required placeholder="e.g. 21/69/0064">
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required style="width:100%; padding:10px 12px; border:1px solid var(--paper-line); border-radius:6px; font-family: var(--sans); font-size:14.5px; resize:vertical;"></textarea>
          </div>
          <button type="submit" class="btn-primary">Send message</button>
        </form>
      </div>
    <% } else { %>
      <div class="card" style="max-width:480px;">
        <h1><%= thread.subject %></h1>
        <p class="subtitle">An administrator will reply here. This page checks for updates automatically — you don't need to log in.</p>

        <div style="max-height:340px; overflow-y:auto; margin-bottom:16px; padding-right:4px;">
          <% messages.forEach(m => { %>
            <div style="margin-bottom:12px; text-align: <%= m.sender === 'admin' ? 'left' : 'right' %>;">
              <div style="display:inline-block; max-width:85%; padding:8px 12px; border-radius:10px; font-size:13.5px; text-align:left;
                background: <%= m.sender === 'admin' ? 'var(--paper)' : 'var(--brand)' %>;
                color: <%= m.sender === 'admin' ? 'var(--ink-on-paper)' : '#fff' %>;">
                <%= m.body %>
              </div>
              <div style="font-size:11px; color: var(--muted-on-paper); margin-top:2px;"><%= m.sender === 'admin' ? 'Support' : 'You' %> · <%= m.created_at %></div>
            </div>
          <% }) %>
        </div>

        <form method="POST" action="/contact/reply">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea name="body" rows="2" placeholder="Type a message..." required style="width:100%; padding:10px 12px; border:1px solid var(--paper-line); border-radius:6px; font-family: var(--sans); font-size:14px; resize:vertical; margin-bottom:10px;"></textarea>
          <button type="submit" class="btn-primary">Send</button>
        </form>
      </div>
    <% } %>

    <div class="auth-footer"><a href="/login">Back to sign in</a></div>
  </div>
</body>
</html>
