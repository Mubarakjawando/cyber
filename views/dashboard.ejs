<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Dashboard — TDPS</title>
  <link rel="stylesheet" href="/css/styles.css?v=3">
</head>
<body class="auth">
  <div class="auth-shell">
    <div class="wordmark" style="display:flex; align-items:center; gap:8px;">
      <img src="/images/mapoly-crest.png" alt="MAPOLY crest" style="height:30px; width:auto; padding:2px; background:#fff; border-radius:5px; box-shadow:0 0 0 1px var(--paper-line);">
      MAPOLY Portal Security
    </div>
    <div class="card">
      <h1>Welcome, <%= fullName && fullName.trim() ? fullName : username %></h1>
      <p class="subtitle">Signed in as <span class="pill pill-ok"><%= role %></span> (<%= username %>)</p>

      <% if (role === 'admin') { %>
        <a href="/admin" class="btn btn-primary" style="display:block; text-align:center; text-decoration:none; margin-bottom:10px;">Open admin console</a>
      <% } %>

      <a href="/account/change-password" class="btn btn-ghost" style="display:block; text-align:center; text-decoration:none; margin-bottom:10px;">Change password</a>

      <form method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-ghost" style="width:100%;">Logout</button>
      </form>
    </div>
  </div>
</body>
</html>
